{
  "name": "audio-intel-ui",
  "private": true,
  "version": "0.1.48",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "design": "node scripts/frontend.mjs design",
    "dev": "node scripts/frontend.mjs dev",
    "check:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "node scripts/check-i18n.mjs && tsc --noEmit -p tsconfig.app.json",
    "build": "node scripts/check-i18n.mjs && tsc --noEmit -p tsconfig.app.json && node scripts/frontend.mjs build && node scripts/copy-swagger-assets.mjs",
    "preview": "node scripts/frontend.mjs preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "i18next": "26.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "17.0.12",
    "swagger-ui-dist": "5.32.14"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2",
    "esbuild": "0.28.2"
  }
}
