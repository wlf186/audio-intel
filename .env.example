# Copy to .env, edit values, then load it before running service.sh:
# set -a; source .env; set +a

AUDIO_INTEL_HOST=0.0.0.0
AUDIO_INTEL_PORT=20810
AUDIO_INTEL_SERVICES=asr,tts
AUDIO_INTEL_API_KEY=
AUDIO_INTEL_MAX_UPLOAD_BYTES=4294967296
AUDIO_INTEL_MAX_TTS_CHARS=50000
AUDIO_INTEL_WORKER_POLL_SECONDS=1
# Cooperative shutdown window before a running task's executor process tree is terminated.
AUDIO_INTEL_CANCEL_GRACE_SECONDS=1
AUDIO_INTEL_MOCK_MODE=0

# Optional project-relative or absolute storage overrides.
AUDIO_INTEL_DATA_DIR=data
AUDIO_INTEL_TEMP_DIR=tmp
AUDIO_INTEL_CACHE_DIR=cache
AUDIO_INTEL_LOG_DIR=logs
AUDIO_INTEL_RUN_DIR=run
AUDIO_INTEL_MODELS_DIR=models
AUDIO_INTEL_FRONTEND_DIR=frontend/dist

# Optional override for the dedicated TTS reference aligner interpreter.
# AUDIO_INTEL_ALIGNER_PYTHON=/absolute/path/to/python

# Optional download proxy. Uncomment both when required.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
